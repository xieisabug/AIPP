{
  "id": "directory-bang-plugin",
  "code": "directory-bang-plugin",
  "name": "目录快捷命令",
  "version": "0.2.0",
  "description": "在输入框用 !directory 或 !dir 列出指定目录的文件和子目录，结果直接放进提示词。",
  "author": "AIPP",
  "entry": "dist/main.js",
  "runtime": {
    "type": "js",
    "entry": "dist/main.js"
  },
  "preview": [
    "preview/1.webp"
  ],
  "pluginTypes": [
    "toolType",
    "applicationType"
  ],
  "permissions": [
    "bang.register"
  ],
  "contributions": {
    "bangs": [
      {
        "name": "directory",
        "aliases": [
          "dir"
        ],
        "complete": "directory(|)",
        "description": "列出指定目录中的文件和子目录，可额外传 recursive=true 与 pattern=*.rs 之类的参数。",
        "executor": {
          "type": "builtinTool",
          "command": "aipp:operation",
          "toolName": "list_directory",
          "arguments": {
            "path": {
              "source": "firstArg",
              "required": true
            },
            "pattern": {
              "source": "named",
              "name": "pattern"
            },
            "recursive": {
              "source": "named",
              "name": "recursive",
              "valueType": "boolean"
            }
          }
        }
      }
    ]
  }
}
