{
  "id": "prompt-optimizer-plugin",
  "code": "prompt-optimizer-plugin",
  "name": "提示词优化",
  "version": "0.2.0",
  "description": "分析当前对话，让模型审阅助手提示词并给出修改建议，对比差异后再应用。",
  "author": "AIPP",
  "entry": "dist/main.js",
  "runtime": {
    "type": "js",
    "entry": "dist/main.js"
  },
  "preview": [
    "preview/1.webp"
  ],
  "pluginTypes": [
    "interfaceType"
  ],
  "kinds": [
    "ui"
  ],
  "permissions": [
    "assistant.config",
    "conversation.read",
    "assistant.read",
    "assistant.prompt.write"
  ],
  "contributions": {
    "actions": [
      {
        "id": "prompt-optimizer",
        "location": "conversation.title-actions",
        "title": "优化提示词",
        "description": "分析当前对话并生成提示词优化建议。",
        "order": 40
      }
    ]
  }
}
