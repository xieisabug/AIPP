{
  "id": "run-script-bang-plugin",
  "code": "run-script-bang-plugin",
  "name": "脚本快捷命令",
  "version": "0.2.0",
  "description": "在输入框用 !run_script、!rs 或 !bash 执行 shell 命令，并把输出放进提示词。",
  "author": "AIPP",
  "entry": "dist/main.js",
  "runtime": {
    "type": "js",
    "entry": "dist/main.js"
  },
  "preview": [
    "preview/1.webp"
  ],
  "pluginTypes": [
    "toolType",
    "applicationType"
  ],
  "permissions": [
    "bang.register"
  ],
  "contributions": {
    "bangs": [
      {
        "name": "run_script",
        "aliases": [
          "rs",
          "bash"
        ],
        "complete": "run_script(|)",
        "description": "执行一段 shell 命令，并将输出直接注入到提示词上下文。",
        "executor": {
          "type": "builtinTool",
          "command": "aipp:operation",
          "toolName": "execute_bash",
          "arguments": {
            "command": {
              "source": "raw",
              "required": true
            },
            "description": {
              "source": "const",
              "value": "Bang plugin: run_script"
            }
          }
        }
      }
    ]
  }
}
