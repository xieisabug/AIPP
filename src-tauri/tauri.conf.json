{
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist",
        "devUrl": "http://localhost:3000"
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": [
            "msi",
            "deb",
            "rpm",
            "appimage",
            "dmg",
            "app"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "artifacts/templates/*/src/**/*",
            "artifacts/templates/*/package.json",
            "artifacts/templates/*/pnpm-lock.yaml",
            "artifacts/templates/*/index.html",
            "artifacts/templates/*/README.md",
            "artifacts/templates/*/tsconfig*.json",
            "artifacts/templates/*/vite.config.ts",
            "artifacts/templates/*/*.d.ts",
            "artifacts/templates/react/.gitignore",
            "artifacts/templates/react/bun.lock",
            "artifacts/templates/react/bunfig.toml",
            "artifacts/templates/react/components.json",
            "artifacts/templates/react/styles/**/*",
            "artifacts/templates/vue/public/**/*",
            "assets/syntaxes.bin",
            "assets/themes.bin"
        ]
    },
    "productName": "Aipp",
    "mainBinaryName": "Aipp",
    "version": "1.7.0",
    "identifier": "com.xieisabug.aipp",
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMjJFMjM1ODIxRTY2RDMKUldUVFpoNkNOZUlpS3RWbDNQajVXM2ZTa1A3eXZRSDdIY3c3M3Y5SXJJa1BWTWh4K1laOG1xUWEK",
            "endpoints": [
                "https://github.com/xieisabug/aipp/releases/latest/download/latest.json"
            ],
            "dialog": false,
            "windows": {
                "installMode": "passive"
            }
        }
    },
    "app": {
        "trayIcon": {
            "id": "aipp",
            "iconAsTemplate": true,
            "iconPath": "icons/favicon.ico"
        },
        "security": {
            "dangerousDisableAssetCspModification": [
                "style-src",
                "img-src"
            ],
            "csp": {
                "default-src": "'self'",
                "frame-src": "'self' http://localhost:* https://localhost:* http://*.aipp-choice.localhost:* https://embed.diagrams.net aipp-choice: http://aipp-choice.localhost https://aipp-choice.localhost aipp-preview: http://aipp-preview.localhost aipp-office: http://aipp-office.localhost",
                "connect-src": "'self' http://localhost:* https://localhost:* ipc: http://ipc.localhost",
                "style-src": "'self' 'unsafe-inline'",
                "font-src": "'self' data:",
                "img-src": "'self' asset: http://asset.localhost data: aipp-preview: http://aipp-preview.localhost aipp-office: http://aipp-office.localhost https://aipp-helper.xiejingyang.com",
                "script-src": "'self' 'unsafe-eval'"
            },
            "assetProtocol": {
                "scope": [
                    "**",
                    "$APPDATA/plugin/**"
                ],
                "enable": true
            }
        }
    }
}
